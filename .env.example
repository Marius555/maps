# Every variable this app reads, with no values. Copy to .env for development.
# Why each one exists: docs/notes/environment.md.
#
# Three groups:
#   1. SITE      — set on the Appwrite Site (production). Values shown are production's.
#   2. SETUP     — read only by `npm run setup:*` / deploy scripts on your machine. Never on the Site.
#   3. DEV ONLY  — local development and the e2e suite. Never on the Site.
#
# NEXT_PUBLIC_* values are inlined at build time: changing one on the Site needs a redeploy.

# ============================================================================
# 1. SITE
# ============================================================================

# --- Appwrite ---------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
DATABASE_ID=
STORAGE_ID=
# SNAPSHOT_STORAGE_ID=              # defaults to STORAGE_ID; read only while SNAPSHOT_PUBLIC_URL is unset

# --- Where this site lives --------------------------------------------------
# Every emailed link, the checkout return and sheet-sync republishes are built
# from this. Required in production: the server refuses to start without it.
APP_URL=https://pinglide.com

# --- Published maps (Cloudflare R2 behind cdn.pinglide.com) -----------------
SNAPSHOT_PUBLIC_URL=https://cdn.pinglide.com
CLOUDFLARE_ACCOUNT_ID=
# A token scoped to Object Read & Write on the snapshots bucket only, no IP filter.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SNAPSHOT_BUCKET=snapshots

# --- The embed --------------------------------------------------------------
NEXT_PUBLIC_EMBED_SCRIPT_URL=https://cdn.pinglide.com/embed/v1/map.js
NEXT_PUBLIC_GAZETTEER_URL=https://cdn.pinglide.com/gazetteer
NEXT_PUBLIC_COLLECT_URL=https://pinglide.com/api/collect
# Upload the embed to the CDN on every deploy (needs the R2 variables at build time).
UPLOAD_EMBED_ON_BUILD=true
# NEXT_PUBLIC_TILES_URL=            # unset = OpenFreeMap

# The site never builds itself: .github/workflows/deploy.yml builds with these
# variables (read from the site at deploy time) and uploads the result.
# BUILD_STANDALONE and SKIP_BUILD_TYPECHECK are set by scripts/deploy-site.mjs,
# never here. docs/notes/deploy.md.

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=support@pinglide.com
# EMAIL_DOMAIN_ALLOWLIST=           # comma-separated domains allowed past the throwaway-address check

# --- Geocoding and routing --------------------------------------------------
GEOAPIFY_API_KEY=
GEOCODER_PROVIDER=geoapify
ROUTING_PROVIDER=geoapify
# GEOAPIFY_MIN_INTERVAL_MS=
# GEOCODER_URL= / GEOCODER_USER_AGENT= / GEOCODER_MIN_INTERVAL_MS=   # Photon, when the provider is unset
# ROUTING_URL= / ROUTING_USER_AGENT= / ROUTING_MIN_INTERVAL_MS=      # OSRM, when the provider is unset

# --- Billing (Lemon Squeezy) ------------------------------------------------
# LEMON_API_KEY wins when both are set; the key itself decides test or live mode.
# Test and live mode have their own variants and webhook: re-run `npm run setup:lemon`
# with the live key, then `npm run setup:lemon -- --verify`.
LEMON_API_KEY=
LEMON_TEST_API_KEY=
LEMON_STORE_ID=
LEMON_WEBHOOK_SECRET=
LEMON_VARIANT_STARTER_MONTHLY=
LEMON_VARIANT_STARTER_YEARLY=
LEMON_VARIANT_PRO_MONTHLY=
LEMON_VARIANT_PRO_YEARLY=

# --- Scheduled sheet sync ---------------------------------------------------
# Same value on the Site and on the googleSheetsUpdate function.
CRON_SECRET=
# SHEET_SYNC_STEP_MS=5000

# --- Visitor analytics ------------------------------------------------------
# Random, 32+ characters. Set once and keep: changing it resets unique-visitor counts.
ANALYTICS_SALT=

# --- Product analytics (PostHog; dashboard and marketing only, never the embed)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_DISABLE_POSTHOG=true  # switches it off with the two above still set

# --- Operator console (/admin) — all three or no console ---------------------
# `npm run admin:hash` prints the last two.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ============================================================================
# 2. SETUP — your machine only, never on the Site
# ============================================================================

# npm run setup:r2 — zone + R2 admin. Narrow, expiring, IP-bound.
CLOUDFLARE_API_TOKEN=
# npm run setup:sheet-sync
CRON_GOOGLE_GOOGLE_SHEETS_UPDATE=
SHEET_SYNC_APP_URL=https://pinglide.com
# APPWRITE_SITE_ID=
# npm run deploy:site — run by the Deploy workflow, whose GitHub secrets hold the
# endpoint, project id, APPWRITE_SITE_ID and a sites.read/sites.write key.

# ============================================================================
# 3. DEV ONLY — never on the Site
# ============================================================================

# Every account reads as pro / as verified. Both are inert in a production build.
# DISABLE_ALL_PLAN=true
# DISABLE_EMAIL_VERIFICATION=true
# Draw every onboarding overlay on every load. NOT inert in production.
# TUTORIAL_ALWAYS_PRESENT=false
# A second /admin login for local use and e2e. Inert in a production build.
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=

# e2e (npm run e2e — e2e/README.md)
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_EMAIL_2=
# E2E_PASSWORD_2=
# E2E_ADMIN_PASSWORD=
# E2E_UNVERIFIED_EMAIL=
# E2E_UNVERIFIED_PASSWORD=
# E2E_BASE_URL=

# npm run danger:wipe-database — accounts that survive a wipe, comma-separated.
# The E2E_* accounts above are kept too. Never on the Site.
# WIPE_KEEP_EMAILS=
