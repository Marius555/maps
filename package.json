{
  "name": "map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "npm run build:embed",
    "build": "next build",
    "start": "next start",
    "copy:maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "build:embed": "vite build --config embed/vite.config.mts && node scripts/copy-maplibre-worker.mjs && node scripts/check-embed-size.mjs",
    "check:embed-size": "node scripts/check-embed-size.mjs",
    "build:gazetteer": "node scripts/build-gazetteer.mjs",
    "build:tile-styles": "node scripts/build-tile-styles.mjs",
    "mirror:tile-assets": "node scripts/mirror-tile-assets.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup:appwrite": "node --env-file=.env scripts/setup-appwrite.mjs",
    "migrate:auto-style": "node --env-file=.env scripts/migrate-auto-style.mjs",
    "migrate:shape-kinds": "node --env-file=.env scripts/migrate-shape-kinds.mjs",
    "migrate:style-host": "node --env-file=.env scripts/migrate-style-host.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.7.1",
    "@internationalized/date": "^3.12.3",
    "@tanstack/react-query": "^5.101.4",
    "appwrite": "^26.2.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.2.0",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "node-appwrite": "^27.1.0",
    "papaparse": "^5.5.4",
    "pmtiles": "^4.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
