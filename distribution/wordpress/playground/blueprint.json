{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post-new.php?post_type=page",
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"PINGLIDE_APP_URL": "http://localhost:3000",
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false
			}
		},
		{ "step": "activatePlugin", "pluginPath": "pinglide/pinglide.php" },
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "plugin-check" }
		}
	]
}
