{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pinglide/map",
	"version": "0.2.0",
	"title": "Pinglide map",
	"category": "embed",
	"icon": "location-alt",
	"description": "A map of your locations. Set it up on Pinglide once; add and edit locations there and this page updates by itself.",
	"keywords": [ "map", "locations", "store locator", "stockists", "dealers" ],
	"textdomain": "pinglide",
	"attributes": {
		"slot": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 520 },
		"mobileHeight": { "type": "number", "default": 0 },
		"width": { "type": "number", "default": 100 },
		"tags": { "type": "array", "items": { "type": "string" }, "default": [] },
		"eager": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right", "wide", "full" ],
		"spacing": { "margin": true },
		"__experimentalBorder": {
			"radius": true,
			"__experimentalDefaultControls": { "radius": true }
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}
